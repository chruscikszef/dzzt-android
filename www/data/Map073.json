{"id":2,"name":"Burmistrz","note":"Osoba, która zarządza całym tym małym państewkiem. Parę lat temu podarował swojemu przyjacielowi, Karambito, część swojej domeny. W ten sposób powstały Karambolowice. Wziąłeś spory kredyt u Burmistrza, aby kupić meble. Chyba czas go spłacić..","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":356,"indent":0,"parameters":["Encyclopedia AddEvent burmistrz_e.png"]},{"code":205,"indent":0,"parameters":[-1,{"list":[{"code":4,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null}]},{"code":205,"indent":0,"parameters":[1,{"list":[{"code":14,"parameters":[0,1],"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":14,"parameters":[0,1],"indent":null}]},{"code":101,"indent":0,"parameters":["burmistrz",2,0,2]},{"code":401,"indent":0,"parameters":["Pan Teklag! Dzień dobry."]},{"code":101,"indent":0,"parameters":["burmistrz",2,0,2]},{"code":401,"indent":0,"parameters":["Czyżby przyszedł pan wreszcie spłacić kredyt?"]},{"code":101,"indent":0,"parameters":["teklag",1,0,2]},{"code":401,"indent":0,"parameters":["Emmmm, nie, nie, to nie dziś..."]},{"code":101,"indent":0,"parameters":["burmistrz",1,0,2]},{"code":401,"indent":0,"parameters":["..."]},{"code":101,"indent":0,"parameters":["teklag",0,0,2]},{"code":401,"indent":0,"parameters":["Mam troszeczkę inną sprawę."]},{"code":101,"indent":0,"parameters":["teklag",2,0,2]},{"code":401,"indent":0,"parameters":["Potrzebuję klucza, który pozwoli mi pójść"]},{"code":401,"indent":0,"parameters":["na wschód lasu."]},{"code":101,"indent":0,"parameters":["teklag",1,0,2]},{"code":401,"indent":0,"parameters":["Droga jest niestety zablokowana..."]},{"code":101,"indent":0,"parameters":["burmistrz",3,0,2]},{"code":401,"indent":0,"parameters":["..."]},{"code":101,"indent":0,"parameters":["burmistrz",1,0,2]},{"code":401,"indent":0,"parameters":["Panie TekLagu..."]},{"code":101,"indent":0,"parameters":["burmistrz",1,0,2]},{"code":401,"indent":0,"parameters":["Wie pan, że te lasy należą do mnie..."]},{"code":101,"indent":0,"parameters":["burmistrz",0,0,2]},{"code":401,"indent":0,"parameters":["Poza częścią wschodnią i waszymi Karambolowicami,"]},{"code":401,"indent":0,"parameters":["które oddałem twojemu przyjacielowi - Karambito."]},{"code":101,"indent":0,"parameters":["burmistrz",1,0,2]},{"code":401,"indent":0,"parameters":["Karambito... To dzięki niemu wciąż"]},{"code":401,"indent":0,"parameters":["tutaj mieszkasz..."]},{"code":101,"indent":0,"parameters":["burmistrz",5,0,2]},{"code":401,"indent":0,"parameters":["Nie spłacasz kredytu, zaniedbujesz waszą"]},{"code":401,"indent":0,"parameters":["wioskę (nie tylko ty). A teraz pytasz mnie o"]},{"code":401,"indent":0,"parameters":["klucz do najniebezpieczniejszej części lasu,"]},{"code":401,"indent":0,"parameters":["do której nawet JA boję się iść?"]},{"code":101,"indent":0,"parameters":["burmistrz",4,0,2]},{"code":401,"indent":0,"parameters":["Po co w ogóle chcesz się tam szlajać?"]},{"code":101,"indent":0,"parameters":["teklag",6,0,2]},{"code":401,"indent":0,"parameters":["Boje się, że coś się stało mojemu"]},{"code":401,"indent":0,"parameters":["przyjacielowi Kassprowi."]},{"code":101,"indent":0,"parameters":["teklag2",4,0,2]},{"code":401,"indent":0,"parameters":["enot- emm... pewien ktoś powiedział"]},{"code":401,"indent":0,"parameters":["mi, że dostał złe wieści od Kasspra, a gdy"]},{"code":401,"indent":0,"parameters":["poszedłem do jego domu to drzwi były zamknięte..."]},{"code":101,"indent":0,"parameters":["teklag2",4,0,2]},{"code":401,"indent":0,"parameters":["Potem usłyszałem szelest dobiegający z drogi"]},{"code":401,"indent":0,"parameters":["na wschód. Gdy próbowałem sprawdzić, co to było,"]},{"code":401,"indent":0,"parameters":["to nie zobaczyłem absolutnie nic."]},{"code":101,"indent":0,"parameters":["teklag2",4,0,2]},{"code":401,"indent":0,"parameters":["Pamiętałem, że jest jeszcze jedna droga, która"]},{"code":401,"indent":0,"parameters":["tam prowadzi, ale przechodzi ona przez pana las."]},{"code":401,"indent":0,"parameters":["Dlatego tutaj przyszedłem..."]},{"code":101,"indent":0,"parameters":["burmistrz",1,0,2]},{"code":401,"indent":0,"parameters":["..."]},{"code":101,"indent":0,"parameters":["burmistrz",1,0,2]},{"code":401,"indent":0,"parameters":["A nie wziąłeś pod uwagę możliwości, że ten"]},{"code":401,"indent":0,"parameters":["szelest mogło spowodować jakieś zwierzę?"]},{"code":101,"indent":0,"parameters":["teklag2",4,0,2]},{"code":401,"indent":0,"parameters":["Nie ma mowy, jestem pewny, że to był człowiek."]},{"code":401,"indent":0,"parameters":["Zwierzęta nie wydają TAKICH dźwięków."]},{"code":101,"indent":0,"parameters":["teklag2",0,0,2]},{"code":401,"indent":0,"parameters":["Słyszałem kroki i tak jakby... Coś się zamknęło..."]},{"code":401,"indent":0,"parameters":["Nie jestem pewny... Ale to na pewno "]},{"code":401,"indent":0,"parameters":["NIE BYŁO zwierzę!"]},{"code":101,"indent":0,"parameters":["burmistrz",6,0,2]},{"code":401,"indent":0,"parameters":["Teklagu... Nie wiem, czy zdajesz sobie sprawę,"]},{"code":401,"indent":0,"parameters":["co znajduje się na wschodzie..."]},{"code":101,"indent":0,"parameters":["burmistrz",4,0,2]},{"code":401,"indent":0,"parameters":["Na wschodzie... Jest mroczniej..."]},{"code":101,"indent":0,"parameters":["burmistrz",2,0,2]},{"code":401,"indent":0,"parameters":["Zamiast pięknych, zielonych dębów i śpiewu"]},{"code":401,"indent":0,"parameters":["ptaków..."]},{"code":101,"indent":0,"parameters":["burmistrz",4,0,2]},{"code":401,"indent":0,"parameters":["Masz mrok... świerkowy las i pustkę..."]},{"code":101,"indent":0,"parameters":["burmistrz",1,0,2]},{"code":401,"indent":0,"parameters":["Całe to miejsce jest wielkim cmentarzyskiem..."]},{"code":101,"indent":0,"parameters":["burmistrz",1,0,2]},{"code":401,"indent":0,"parameters":["Ludzi poległych na krwawej wojnie..."]},{"code":101,"indent":0,"parameters":["teklag",3,0,2]},{"code":401,"indent":0,"parameters":["Wojnie...?"]},{"code":101,"indent":0,"parameters":["burmistrz",1,0,2]},{"code":401,"indent":0,"parameters":["Nie dziwię się, że o niej nie wiesz... I lepiej"]},{"code":401,"indent":0,"parameters":["żeby jak najmniej ludzi o tym wiedziało..."]},{"code":101,"indent":0,"parameters":["burmistrz",4,0,2]},{"code":401,"indent":0,"parameters":["To wywołałoby masową panikę."]},{"code":101,"indent":0,"parameters":["teklag",4,0,2]},{"code":401,"indent":0,"parameters":["Na wschodzie lasu doszło do wojny...?"]},{"code":101,"indent":0,"parameters":["teklag2",5,0,2]},{"code":401,"indent":0,"parameters":["Dlaczego nikt nic o tym nie wie?!"]},{"code":101,"indent":0,"parameters":["burmistrz",1,0,2]},{"code":401,"indent":0,"parameters":["Już mówiłem..."]},{"code":101,"indent":0,"parameters":["burmistrz",4,0,2]},{"code":401,"indent":0,"parameters":["Nie mogliśmy pozwolić na masową panikę..."]},{"code":101,"indent":0,"parameters":["teklag2",6,0,2]},{"code":401,"indent":0,"parameters":["Czyli nie pomogłeś ludziom ze wschodu, a na"]},{"code":401,"indent":0,"parameters":["dodatek naraziłeś swoich ludzi na"]},{"code":401,"indent":0,"parameters":["niebezpieczeństwo, o którym nawet nie wiedzieli?!"]},{"code":101,"indent":0,"parameters":["burmistrz",5,0,2]},{"code":401,"indent":0,"parameters":["NIE ROZUMIESZ!"]},{"code":101,"indent":0,"parameters":["burmistrz",5,0,2]},{"code":401,"indent":0,"parameters":["Mydralis wygrał wojnę! Dzień po jej rozpoczęciu!"]},{"code":101,"indent":0,"parameters":["teklag2",4,0,2]},{"code":401,"indent":0,"parameters":["Mydralis...?"]},{"code":101,"indent":0,"parameters":[