{"id":1,"name":"Małpa","note":"Zawodowy gracz Bloons TD 6 i król małpkowej rebelii. Kocha nektarynki oraz banany w proszku. Małpa jakiś czas temu został pracownikiem Felesa i wraz z nim wita ludzi, bo również chce poprawiać im humor.","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":true,"image":{"tileId":0,"characterName":"monkey","direction":2,"pattern":1,"characterIndex":0},"list":[{"code":356,"indent":0,"parameters":["Encyclopedia AddEvent monkey_e.png"]},{"code":101,"indent":0,"parameters":["Monkey",2,0,2]},{"code":401,"indent":0,"parameters":["Hej, Teklagu."]},{"code":101,"indent":0,"parameters":["Monkey",2,0,2]},{"code":401,"indent":0,"parameters":["Chciałbyś wysłuchać mojej historii?"]},{"code":102,"indent":0,"parameters":[["Tak"],-1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Tak"]},{"code":101,"indent":1,"parameters":["Monkey",2,0,2]},{"code":401,"indent":1,"parameters":["No dobrze, więc słuchaj."]},{"code":101,"indent":1,"parameters":["Monkey",0,0,2]},{"code":401,"indent":1,"parameters":["Pewnego dnia... \\. Zadzwoniłem do Demencji."]},{"code":101,"indent":1,"parameters":["teklag2",1,0,2]},{"code":401,"indent":1,"parameters":["Po co?"]},{"code":101,"indent":1,"parameters":["Monkey",1,0,2]},{"code":401,"indent":1,"parameters":["Żeby zagrać z nim w Portala."]},{"code":101,"indent":1,"parameters":["teklag2",1,0,2]},{"code":401,"indent":1,"parameters":["W jedynkę czy dwójkę?"]},{"code":101,"indent":1,"parameters":["Monkey",6,0,2]},{"code":401,"indent":1,"parameters":["Oj... \\. Przepraszam, że nie doprecyzowałem."]},{"code":101,"indent":1,"parameters":["Monkey",6,0,2]},{"code":401,"indent":1,"parameters":["Po prostu czasem tak mam, że chcę coś powiedzieć,"]},{"code":401,"indent":1,"parameters":["ale sam się w tym gubię... \\. "]},{"code":401,"indent":1,"parameters":["Wiesz jak to jest?"]},{"code":101,"indent":1,"parameters":["Monkey",6,0,2]},{"code":401,"indent":1,"parameters":["Jakby, ja nie chciałem tak zrobić. Serio, przepraszam. "]},{"code":401,"indent":1,"parameters":["Po prostu tak czasem mam i nie wiem, zdarza mi się"]},{"code":401,"indent":1,"parameters":["nie doprecyzować czegoś..."]},{"code":101,"indent":1,"parameters":["teklag",0,0,2]},{"code":401,"indent":1,"parameters":["Dobra, luz, nie przepraszaj."]},{"code":101,"indent":1,"parameters":["Monkey",6,0,2]},{"code":401,"indent":1,"parameters":["Okej. \\. "]},{"code":401,"indent":1,"parameters":["Przepraszam."]},{"code":101,"indent":1,"parameters":["Monkey",6,0,2]},{"code":401,"indent":1,"parameters":["Po prostu czasem już tak mam, że jak przepraszam,"]},{"code":401,"indent":1,"parameters":["to zaczynam się troche rozgadywać i w ogóle zdarza"]},{"code":401,"indent":1,"parameters":["mi się przepraszać za kompletne głupoty, nie jestem"]},{"code":401,"indent":1,"parameters":["w stanie tego kontrolować, to samo ze mnie wychodzi..."]},{"code":101,"indent":1,"parameters":["teklag2",4,0,2]},{"code":401,"indent":1,"parameters":["..."]},{"code":101,"indent":1,"parameters":["teklag2",4,0,2]},{"code":401,"indent":1,"parameters":["Dobra. Skończ."]},{"code":101,"indent":1,"parameters":["Monkey",6,0,2]},{"code":401,"indent":1,"parameters":["Przepra-"]},{"code":101,"indent":1,"parameters":["teklag",5,0,2]},{"code":401,"indent":1,"parameters":["Po prostu powiedz, w którego Portala graliście!"]},{"code":101,"indent":1,"parameters":["Monkey",6,0,2]},{"code":401,"indent":1,"parameters":["Dobra, przepraszam, już mówię."]},{"code":101,"indent":1,"parameters":["Monkey",6,0,2]},{"code":401,"indent":1,"parameters":["Jakby, sorki, że tak długo przepraszam, ale ja"]},{"code":401,"indent":1,"parameters":["naprawdę-"]},{"code":101,"indent":1,"parameters":["teklag2",6,0,2]},{"code":401,"indent":1,"parameters":["W KTÓREGO GRALIŚCIE PORTALA!?!"]},{"code":101,"indent":1,"parameters":["Monkey",6,0,2]},{"code":401,"indent":1,"parameters":["..."]},{"code":101,"indent":1,"parameters":["Monkey",7,0,2]},{"code":401,"indent":1,"parameters":["Graliśmy w dwójkę..."]},{"code":101,"indent":1,"parameters":["teklag",5,0,2]},{"code":401,"indent":1,"parameters":["I co było dalej?"]},{"code":101,"indent":1,"parameters":["Monkey",0,0,2]},{"code":401,"indent":1,"parameters":["No dobra, więc potem, kiedy skończyliśmy grać,"]},{"code":401,"indent":1,"parameters":["wyszedłem na dwór i spotkałem wtedy Pak000sza."]},{"code":101,"indent":1,"parameters":["Monkey",1,0,2]},{"code":401,"indent":1,"parameters":["No i... \\. Nie jest to zbytnio ważne, Pak000sz"]},{"code":401,"indent":1,"parameters":["chciał w sumie coś tylko potrzymać i tyle."]},{"code":401,"indent":1,"parameters":["No i poszedłem sobie na zachód."]},{"code":101,"indent":1,"parameters":["teklag",1,0,2]},{"code":401,"indent":1,"parameters":["To po co wspomniałeś o tym Pak000szu, skoro to"]},{"code":401,"indent":1,"parameters":["nieważne?"]},{"code":101,"indent":1,"parameters":["Monkey",6,0,2]},{"code":401,"indent":1,"parameters":["Jejku, przepraszam. Ja po prostu chciałem"]},{"code":401,"indent":1,"parameters":["dokładnie opisać tę przepiękną historię"]},{"code":401,"indent":1,"parameters":["i to jak-"]},{"code":101,"indent":1,"parameters":["teklag",5,0,2]},{"code":401,"indent":1,"parameters":["Dobra, mów dalej."]},{"code":101,"indent":1,"parameters":["Monkey",6,0,2]},{"code":401,"indent":1,"parameters":["Przepraszam."]},{"code":101,"indent":1,"parameters":["Monkey",2,0,2]},{"code":401,"indent":1,"parameters":["No więc później poszedłem na zachód-"]},{"code":101,"indent":1,"parameters":["teklag2",4,0,2]},{"code":401,"indent":1,"parameters":["Przecież zachód jest zamknięty, w drugiej"]},{"code":401,"indent":1,"parameters":["części Karambolowic trwa remont."]},{"code":101,"indent":1,"parameters":["Monkey",6,0,2]},{"code":401,"indent":1,"parameters":["No tak, przepraszam. W późniejszej części"]},{"co